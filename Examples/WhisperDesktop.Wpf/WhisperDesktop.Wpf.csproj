<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>WhisperDesktop.Modern</AssemblyName>
    <RootNamespace>WhisperDesktop.Modern</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\WhisperNet\WhisperNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\x64\$(Configuration)\Whisper.dll" Link="Whisper.dll" Condition="Exists('..\..\x64\$(Configuration)\Whisper.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildWhisperCppBackend" BeforeTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\Tools\build-whispercpp.cmd&quot;" />
  </Target>
  <Target Name="CopyWhisperCppBackend" AfterTargets="Build">
    <Delete Files="$(OutDir)WhisperCppBackend.dll" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\Native\WhisperCppBackend\build-cpu\bin\WhisperCppBackendCpu.dll;
                       $(MSBuildProjectDirectory)\..\..\Native\WhisperCppBackend\build-cuda\bin\WhisperCppBackendCuda.dll;
                       $(CUDA_PATH)\bin\x64\cublas64_13.dll;
                       $(CUDA_PATH)\bin\x64\cublasLt64_13.dll;
                       $(CUDA_PATH)\bin\x64\cudart64_13.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
